# SkillGap Environment Configuration

# Application
PROJECT_NAME="SkillGap"
ENVIRONMENT="development"

# Security
JWT_SECRET="skillgap-super-secret-production-key-change-in-prod-9834194821"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL in Docker / SQLite in local dev)
DATABASE_URL="sqlite:///./skillgap.db"
# DATABASE_URL="postgresql://skillgap_user:skillgap_password@localhost:5432/skillgap_db"

# AI Service (Optional - system includes deterministic fallback)
AI_PROVIDER="gemini" # or "openai" / "local_fallback"
AI_API_KEY="your-gemini-or-openai-api-key-here"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
